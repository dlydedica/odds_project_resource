{
  "type": "newsUiResponse",
  "schema_version": "1.0.0",
  "tab_id": "news",
  "data_source": {
    "mode": "collection",
    "feed_id_prefix": "news-rss-main:",
    "mapper": "news.v1",
    "required": true
  },
  "scorex_tokens": {
    "color_accent": "#F52F3B",
    "color_bg_secondary": "#FFFFFF",
    "color_border": "#E6E6E6",
    "color_text_primary": "#141414",
    "color_text_secondary": "#6F6F6F"
  },
  "scorex_tokens_dark": {
    "color_accent": "#F52F3B",
    "color_bg_secondary": "#1C1C1C",
    "color_border": "#2A2A2A",
    "color_text_primary": "#FFFFFF",
    "color_text_secondary": "#AAAAAA"
  },
  "news_card": {
    "template": "scorex_compact_media",
    "time_mode": "relative",
    "relative_time_max_days": 7,
    "time_labels": {
      "no_date": "No date",
      "just_now": "just now",
      "minutes_ago": "min ago",
      "hours_ago": "h ago",
      "days_ago": "d ago"
    },
    "layout": {
      "card_border_radius": 12,
      "card_padding": 10,
      "thumbnail_gap": 10,
      "thumbnail_border_radius": 10,
      "title_to_description_gap": 6,
      "description_to_meta_gap": 8,
      "placeholder_icon_size": 20,
      "meta_icon_size": 14,
      "meta_icon_text_gap": 4
    },
    "typography": {
      "title": {
        "font_size": 14,
        "font_weight": "w700",
        "line_height": 1.2
      },
      "description": {
        "font_size": 12,
        "font_weight": "w400",
        "line_height": 1.25
      },
      "meta": {
        "font_size": 11,
        "font_weight": "w500",
        "line_height": 1.2
      }
    },
    "thumbnail_width_ratio": 0.38,
    "thumbnail_aspect_ratio": 1.777,
    "title_max_lines": 2,
    "description_max_lines": 2,
    "show_description": true,
    "skeleton": {
      "item_count": 5,
      "item_height": 96,
      "fill_color_light": "#ECECEC",
      "fill_color_dark": "#313131",
      "card_color_light": "#F3F3F3",
      "card_color_dark": "#222222",
      "card_border_color_light": "#E5E5E5",
      "card_border_color_dark": "#2A2A2A",
      "line_radius": 4,
      "title_line_height": 14,
      "title_secondary_width_ratio": 0.62,
      "description_line_height": 11,
      "description_secondary_width_ratio": 0.45,
      "date_line_height": 11,
      "date_width_ratio": 0.32
    }
  },
  "news_list": {
    "content_padding": [0, 12, 0, 20],
    "item_gap": 10
  }
}

