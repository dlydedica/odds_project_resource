{
  "transport": {
    "cache": {
      "stale_while_revalidate_seconds": 60,
      "max_age_seconds": 300
    },
    "retry": {
      "backoff_ms": 400,
      "max_attempts": 2
    }
  },
  "actions": {
    "contracts": [
      {
        "optional": [
          "section",
          "params",
          "tracking_id"
        ],
        "type": "inApp",
        "required": [
          "page"
        ]
      },
      {
        "optional": [
          "external",
          "tracking_id"
        ],
        "type": "openUrl",
        "required": [
          "url"
        ]
      }
    ]
  }
}
