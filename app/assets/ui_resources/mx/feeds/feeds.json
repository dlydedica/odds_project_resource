                    "ttl_sec": 300
                },
                "delivery": "redirect",
                "polling": {
                    "enabled": false
                }
            },
            "endpoints": [{
                    "feed_key": "football",
                    "title": "Liga MX",
                    "endpoint": "https://e01-mx-marca.uecdn.es/mx/rss/futbol/liga-mx.xml"
                },
