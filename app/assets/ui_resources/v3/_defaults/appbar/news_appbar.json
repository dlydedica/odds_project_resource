{
    "version": "1.0.0",
    "type": "appBar",
    "title": {
        "type": "textField",
        "hintText": "{{t.news.search_hint}}",
        "prefixIcon": {
            "type": "icon",
            "icon": "search",
            "size": "{{token.size.icon.sm}}"
        },
        "onChanged": {
            "actionType": "actionRef",
            "ref": "search_news"
        }
    },
    "leading": {
        "type": "iconButton",
        "icon": {"type": "icon", "icon": "arrow_back"},
        "onPressed": {
            "actionType": "actionRef",
            "ref": "navigate_home"
        },
        "tooltip": "{{t.nav.back_tooltip}}"
    },
    "backgroundColor": "{{token.custom.surface.light}}",
    "foregroundColor": "{{token.custom.on_surface.light}}",
    "elevation": 0
}