{
    "type": "column",
    "mainAxisAlignment": "center",
    "crossAxisAlignment": "center",
    "children": [
        {
            "type": "icon",
            "icon": "error",
            "size": "{{token.icon_size_xl}}",
            "color": "{{token.accent}}"
        },
        {
            "type": "sizedBox",
            "height": "{{token.spacing_xl}}"
        },
        {
            "type": "text",
            "data": "{{t:fallback.init_failed.title}}",
            "style": {
                "fontFamily": "Roboto",
                "fontSize": "{{token.font_2xl}}",
                "fontWeight": "{{token.font_bold}}",
                "color": "{{token.text_primary}}"
            }
        },
        {
            "type": "sizedBox",
            "height": 8
        },
        {
            "type": "text",
            "data": "{{t:fallback.init_failed.message}}",
            "textAlign": "center",
            "style": {
                "fontFamily": "Roboto",
                "fontSize": "{{token.font_base}}",
                "fontWeight": "{{token.font_normal}}",
                "color": "{{token.text_secondary}}"
            }
        },
        {
            "type": "sizedBox",
            "height": "{{token.spacing_xxl}}"
        },
        {
            "type": "inAppLinkContainer",
            "link": "app://callback/retry_init",
            "child": {
                "type": "container",
                "padding": [
                    20,
                    12,
                    20,
                    12
                ],
                "decoration": {
                    "color": "{{token.accent}}",
                    "borderRadius": "{{token.radius_button}}"
                },
                "child": {
                    "type": "text",
                    "data": "{{t:fallback.retry_button}}",
                    "style": {
                        "fontFamily": "Roboto",
                        "fontSize": "{{token.font_lg}}",
                        "fontWeight": "{{token.font_bold}}",
                        "color": "{{token.bg_light}}"
                    }
                }
            }
        }
    ]
}