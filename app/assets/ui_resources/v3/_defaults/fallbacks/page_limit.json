{
    "type": "column",
    "mainAxisAlignment": "center",
    "crossAxisAlignment": "center",
    "children": [
        {
            "type": "icon",
            "icon": "lock",
            "size": "{{token.icon_size_xl}}",
            "color": "{{token.text_secondary}}"
        },
        {
            "type": "sizedBox",
            "height": "{{token.spacing_xl}}"
        },
        {
            "type": "text",
            "data": "{{t:fallback.page_limit.title}}",
            "style": {
                "fontFamily": "Roboto",
                "fontSize": "{{token.font_2xl}}",
                "fontWeight": "{{token.font_bold}}",
                "color": "{{token.text_primary}}"
            }
        },
        {
            "type": "sizedBox",
            "height": 8
        },
        {
            "type": "text",
            "data": "{{t:fallback.page_limit.message}}",
            "style": {
                "fontFamily": "Roboto",
                "fontSize": "{{token.font_base}}",
                "fontWeight": "{{token.font_normal}}",
                "color": "{{token.text_secondary}}"
            }
        }
    ]
}