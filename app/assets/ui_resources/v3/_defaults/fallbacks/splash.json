{
    "type": "column",
    "mainAxisAlignment": "center",
    "crossAxisAlignment": "center",
    "children": [
        {
            "type": "image",
            "src": "{{t:splash.logo_url}}",
            "imageType": "network",
            "width": "{{token.logo_size}}",
            "height": "{{token.logo_size}}",
            "fit": "contain"
        },
        {
            "type": "sizedBox",
            "height": "{{token.spacing_xxl}}"
        },
        {
            "type": "text",
            "data": "{{t:splash.title}}",
            "style": {
                "fontFamily": "Roboto",
                "fontSize": "{{token.font_3xl}}",
                "fontWeight": "{{token.font_bold}}",
                "color": "{{token.text_primary}}"
            }
        },
        {
            "type": "sizedBox",
            "height": 32
        },
        {
            "type": "container",
            "width": "{{token.splash_loader_size}}",
            "height": "{{token.spacing_xxl}}",
            "child": {
                "type": "image",
                "src": "https://s3.regru.cloud/line-game-img/odds/images/loader.svg",
                "imageType": "network",
                "fit": "contain"
            }
        }
    ]
}