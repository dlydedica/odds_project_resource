{
    "version": "1.0.0",
    "type": "column",
    "children": [
        {
            "type": "dataList",
            "source": "events.live",
            "dataPath": "events",
            "retryCount": 2,
            "retryDelayMs": 2000,
            "loading": {
                "type": "column",
                "children": [
                    {
                        "type": "shimmer_block",
                        "height": 180,
                        "borderRadius": "{{token.corner_radius.card}}",
                        "margin": {
                            "bottom": "{{token.spacing.lg}}"
                        }
                    },
                    {
                        "type": "shimmer_block",
                        "height": 24,
                        "width": "50%",
                        "borderRadius": 4,
                        "margin": {
                            "bottom": "{{token.spacing.md}}"
                        }
                    },
                    {
                        "type": "row",
                        "spacing": "{{token.spacing.md}}",
                        "children": [
                            {
                                "type": "shimmer_block",
                                "height": 160,
                                "width": "48%",
                                "borderRadius": "{{token.corner_radius.card}}"
                            },
                            {
                                "type": "shimmer_block",
                                "height": 160,
                                "width": "48%",
                                "borderRadius": "{{token.corner_radius.card}}"
                            }
                        ]
                    }
                ]
            },
            "empty": {
                "type": "column",
                "mainAxisAlignment": "center",
                "crossAxisAlignment": "center",
                "padding": {
                    "vertical": 48
                },
                "children": [
                    {
                        "type": "icon",
                        "icon": "sports_esports",
                        "size": 48,
                        "color": "{{token.custom.on_surface_variant.light}}"
                    },
                    {
                        "type": "sizedBox",
                        "height": "{{token.spacing.md}}"
                    },
                    {
                        "type": "text",
                        "data": "{{t.home.empty_title}}",
                        "style": {
                            "fontFamily": "Roboto",
                            "fontSize": "{{token.size.font.lg}}",
                            "color": "{{token.custom.on_surface_variant.light}}"
                        }
                    }
                ]
            },
            "error": {
                "type": "column",
                "mainAxisAlignment": "center",
                "crossAxisAlignment": "center",
                "padding": {
                    "vertical": 48
                },
                "children": [
                    {
                        "type": "text",
                        "data": "{{t.fallback.load_error}}",
                        "style": {
                            "color": "{{token.custom.on_surface_variant.light}}",
                            "fontSize": "{{token.size.font.md}}"
                        }
                    }
                ]
            },
            "itemTemplate": {
                "type": "container",
                "padding": {
                    "all": "{{token.spacing.md}}"
                },
                "decoration": {
                    "color": "{{token.custom.surface_container.light}}",
                    "borderRadius": "{{token.corner_radius.card}}"
                },
                "margin": {
                    "bottom": "{{token.spacing.sm}}"
                },
                "child": {
                    "type": "row",
                    "crossAxisAlignment": "center",
                    "mainAxisAlignment": "spaceBetween",
                    "children": [
                        {
                            "type": "column",
                            "spacing": 4,
                            "crossAxisAlignment": "start",
                            "children": [
                                {
                                    "type": "text",
                                    "data": "{{item.competition_name}}",
                                    "style": {
                                        "fontSize": "{{token.size.font.xs}}",
                                        "color": "{{token.custom.on_surface_variant.light}}"
                                    }
                                },
                                {
                                    "type": "text",
                                    "data": "{{item.team_home_name}} vs {{item.team_away_name}}",
                                    "style": {
                                        "fontSize": "{{token.size.font.md}}",
                                        "fontWeight": "{{token.typography.fontWeight.medium}}",
                                        "color": "{{token.custom.on_surface.light}}"
                                    }
                                },
                                {
                                    "type": "row",
                                    "spacing": 8,
                                    "children": [
                                        {
                                            "type": "text",
                                            "data": "{{item.team_home_score}}",
                                            "style": {
                                                "fontSize": "{{token.size.font['2xl']}}",
                                                "fontWeight": "{{token.typography.fontWeight.bold}}",
                                                "color": "{{token.primary}}"
                                            }
                                        },
                                        {
                                            "type": "text",
                                            "data": ":",
                                            "style": {
                                                "fontSize": "{{token.size.font['2xl']}}",
                                                "color": "{{token.custom.on_surface_variant.light}}"
                                            }
                                        },
                                        {
                                            "type": "text",
                                            "data": "{{item.team_away_score}}",
                                            "style": {
                                                "fontSize": "{{token.size.font['2xl']}}",
                                                "fontWeight": "{{token.typography.fontWeight.bold}}",
                                                "color": "{{token.primary}}"
                                            }
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "type": "container",
                            "padding": {
                                "horizontal": "{{token.spacing.md}}",
                                "vertical": "{{token.spacing.xs}}"
                            },
                            "decoration": {
                                "color": "{{token.primary}}",
                                "borderRadius": "{{token.corner_radius.full}}"
                            },
                            "child": {
                                "type": "text",
                                "data": "{{item.match_time}}",
                                "style": {
                                    "fontSize": "{{token.size.font.sm}}",
                                    "color": "{{token.custom.surface.light}}"
                                }
                            }
                        }
                    ]
                }
            }
        }
    ]
}